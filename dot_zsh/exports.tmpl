# vim: set filetype=sh:

### Path:
# Homebrew paths come from `brew shellenv` in ~/.zprofile, no need to add here.
export PATH="$HOME/.local/bin:$PATH" # Claude Code default + custom scripts
export PATH="./node_modules/.bin:$PATH" # local npm executables
export PATH="./.bundle/binstubs:$PATH" # local bundler executables
export PATH="$HOME/go/bin:$PATH" # go installed stuff
export PATH="{{ if eq .chezmoi.arch "arm64" }}/opt/homebrew{{ else }}/usr/local{{ end }}/opt/openjdk/bin:$PATH" # openjdk for real java

# diff-highlight (path differs by Homebrew layout)
{{- if eq .chezmoi.arch "arm64" }}
export PATH="/opt/homebrew/share/git-core/contrib/diff-highlight:$PATH"
{{- else }}
export PATH="/usr/local/share/git-core/contrib/diff-highlight:$PATH"
{{- end }}

# Get FZF to ignore gitignored files
export FZF_DEFAULT_COMMAND='ag -l -g ""'

TZ="Europe/London"
export LC_ALL='en_GB.UTF-8'

export GIT_MERGE_AUTOEDIT=no

export EDITOR='nvim'
export PAGER='less'

# Report time of commands over 5 seconds
export REPORTTIME=5

# Homebrew security options
export HOMEBREW_NO_INSECURE_REDIRECT=1
export HOMEBREW_CASK_OPTS=--require-sha
export HOMEBREW_NO_ANALYTICS=1

# GnuPG
export KEYID=5D18EDB8080CF576089FF13271E55778F1E239EB
export GPG_TTY="$(tty)"
export SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"

# Share Go build and yarn module caches
export YARN_CACHE_FOLDER="$HOME/.cache/yarn"
export GOCACHE="$HOME/.cache/go-build"
