{{- /*
  Public settings live in .chezmoitemplates/claude-settings.json. Work-specific
  settings live in the dotfiles-private overlay and are merged on top when it is
  on disk. mergeOverwrite replaces lists, so permission lists are concatenated
  by hand.
*/ -}}
{{- $settings := includeTemplate "claude-settings.json" . | fromJson -}}
{{- $privatePath := joinPath .chezmoi.homeDir "me" "dotfiles-private" "claude" "settings.json" -}}
{{- if stat $privatePath -}}
{{-   $private := includeTemplate $privatePath . | fromJson -}}
{{-   $lists := dict -}}
{{-   range $key := list "allow" "ask" "deny" -}}
{{-     $combined := concat (dig "permissions" $key list $settings) (dig "permissions" $key list $private) -}}
{{-     if $combined -}}{{ $_ := set $lists $key $combined }}{{ end -}}
{{-   end -}}
{{-   $settings = mergeOverwrite $settings $private -}}
{{-   range $key, $combined := $lists -}}{{ $_ := set $settings.permissions $key $combined }}{{ end -}}
{{- end -}}
{{ toPrettyJson $settings }}
