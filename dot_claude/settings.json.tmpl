{
  "permissions": {
    "allow": [
      "mcp__incident_io__*",
      "Skill(incident)",
      "Bash(make -B recreatedb migrate PGDATABASE=test)",
      "Bash(make -B recreatedb migrate PGDATABASE=test:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "worktree": {
    "symlinkDirectories": [
      ".yarn/cache"
    ],
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "sh {{ .chezmoi.homeDir }}/.claude/statusline-command.sh"
  },
  "hooks": {
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_ONLY=1 AGENT_IDLE_MIN=60 /bin/bash {{ .chezmoi.homeDir }}/.claude/scripts/prune-idle-worktrees.sh 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "open-plan-annotator@open-plan-annotator": true,
    "slack@claude-plugins-official": true,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "open-plan-annotator": {
      "source": {
        "source": "github",
        "repo": "ndom91/open-plan-annotator"
      }
    }
  },
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen",
  "agentPushNotifEnabled": true
}
